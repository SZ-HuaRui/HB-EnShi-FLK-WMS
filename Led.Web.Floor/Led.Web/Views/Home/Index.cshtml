@model IEnumerable<Led.Model.ItemProduction>
@{
    ViewBag.Title = "主页";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    int inqty = 0;
    int outqty = 0;
}

<div id="top-div">
    <table id="item-table" style="width:100%;height:100%;background-color:#215e82;" border=1>
        <tr>
            <th class="info-td" width="10%" height="100px" style="color:white">序号</th>
            <th class="info-td" width="20%" height="100px" style="color:white">品牌编码</th>
            <th class="info-td" width="50%" height="100px" style="color:white">品牌名称</th>
            <th class="info-td" width="10%" height="100px" style="color:white">卷包出库</th>
            <th class="info-td" width="10%" height="100px" style="color:white">物流入库</th>
        </tr>

        @for (int i = 0; i < Model.Count(); i++)
        {
            <tr>
                <td class="info-td" height="100px">@(i + 1)</td>
                <td class="info-td" height="100px">@(Model.ElementAt(i).ItemCode)</td>
                <td class="info-td" height="100px">@(Model.ElementAt(i).ItemName)</td>
                <td class="info-td" height="100px">@(Model.ElementAt(i).outQty)</td>
                <td class="info-td" height="100px">@(Model.ElementAt(i).inQty)</td>
            </tr>
        }
        <tr>
            <td class="info-td" height="100px">
                合计
            </td>
            <td class="info-td" height="100px"></td>
            <td class="info-td" height="100px"></td>
            <td class="info-td" height="100px">

                @for (int i = 0; i < Model.Count(); i++)
                {
                    inqty = Convert.ToInt32(Model.ElementAt(i).outQty) + outqty;
                }
                @outqty
            </td>
            <td class="info-td" height="100px">

                @for (int i = 0; i < Model.Count(); i++)
                {
                    outqty = Convert.ToInt32(Model.ElementAt(i).inQty) + inqty;
                }
                @inqty
            </td>
        </tr>
        @if (ViewBag.LastClassProduction.IsShow)
        {
            <tr>
                <td class="info-td" height="100px">
                    白班产量
                </td>
                <td class="info-td" height="100px"></td>
                <td class="info-td" height="100px">
                    08:00:00 -- 17:12:00
                </td>
                <td class="info-td" height="100px">
                    @ViewBag.LastClassProduction.outQty
                </td>
                <td class="info-td" height="100px">
                    @ViewBag.LastClassProduction.inQty
                </td>
            </tr>
        }
    </table>

</div>


<script type="text/javascript">
    $(function () {
        setInterval(reflash, 5000);
    });

    function reflash() {
        window.location.reload();
    };





</script>

<style type="text/css">
    .info-td {
        font-size: 40px;
        text-align: center;
        color: yellow;
        border-width: 7px;
        border: solid #ffffff;
    }
</style>