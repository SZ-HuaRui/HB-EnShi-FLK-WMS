<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!--- ServerGarbageCollection ： 服务器垃圾收集 ：不会让内存无限增长 -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <UserSecretsId>495e336a-85b3-497a-95f6-b4d8589c94fd</UserSecretsId>
    <!--- ServerGarbageCollection ： 并发垃圾收集 ：不会让内存无限增长 -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="NtiCloudServerLogs\**" />
    <EmbeddedResource Remove="NtiCloudServerLogs\**" />
    <None Remove="NtiCloudServerLogs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Consul" Version="1.6.1.1" />
    <PackageReference Include="CSRedisCore" Version="3.6.5" />
    <!--PackageReference Include="QRCoder" Version="1.4.1" /-->
    <!--PackageReference Include="FreeSpire.XLS" Version="10.10.0" /-->
    <!--PackageReference Include="DotNetZip" Version="1.15.0" /-->
    <!--PackageReference Include="FluentScheduler" Version="5.5.1" /-->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="5.6.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="5.6.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="5.0.0" />
    <PackageReference Include="System.Data.Odbc" Version="5.0.0" />
    <PackageReference Include="MySql.Data" Version="8.0.22" />
    <PackageReference Include="Npgsql" Version="5.0.1.1" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.2" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="2.19.100" />
    <PackageReference Include="Snowflake.NetCore" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="5.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NtiCloud.Consul.Core">
      <HintPath>..\MicroservicesLibs\Components\NtiCloud.Consul.Core.dll</HintPath>
    </Reference>
    <Reference Include="NtiCloud.Kernel.Core">
      <HintPath>..\MicroservicesLibs\Components\NtiCloud.Kernel.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
