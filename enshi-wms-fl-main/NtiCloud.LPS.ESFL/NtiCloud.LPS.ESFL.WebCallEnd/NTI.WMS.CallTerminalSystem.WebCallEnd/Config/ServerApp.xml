<?xml version="1.0" encoding="utf-8" ?>
<objects xmlns="http://www.springframework.net" xmlns:wcf="http://www.springframework.net/wcf">

  <object id="Initialize"
          type="WMSInterface.InitializeWS, WMSInterface"
          factory-object="InitializeFactory"
          factory-method="CreateChannel" singleton ="false"
          destroy-method ="Close"/>

  <object id="InitializeFactory" type="System.ServiceModel.ChannelFactory&lt;WMSInterface.InitializeWS>, System.ServiceModel">
    <constructor-arg name="endpointConfigurationName" value="Initialize"/>
  </object>

  <object id="CallEnd"
      type="WMSInterface.CallEndWS, WMSInterface"
      factory-object="CallEndFactory"
      factory-method="CreateChannel" 
      destroy-method ="Close" singleton ="false"/>

  <object id="CallEndFactory"  type="System.ServiceModel.ChannelFactory&lt;WMSInterface.CallEndWS>, System.ServiceModel">
    <constructor-arg name="endpointConfigurationName" value="CallEnd"/>
  </object>

</objects>

