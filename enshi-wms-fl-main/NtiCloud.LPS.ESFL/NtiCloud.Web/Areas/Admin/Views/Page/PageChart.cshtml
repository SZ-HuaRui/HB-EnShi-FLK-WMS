@{
    Layout = "~/Areas/Admin/Shared/LayoutEasyUI.cshtml";
}
@section TitleSection{@(ViewBag.SystemName + "图表展示")}
@section HeaderSection
    {
    <link href="~/areas/admin/css/setChart.css" rel="stylesheet" />
    <script src="~/lib/echarts/echarts.min.js"></script>
    <script src="~/lib/echarts/ecStat.js"></script>
    <script src="~/lib/echarts/echarts.theme.shine.js"></script>
}
@section ContentBody{
    <body style="overflow:hidden;">
        @Html.AntiForgeryToken()
        <div class="chartArea">
            <div id="chart_1" class="chart"></div>
        </div>
        <script type="text/javascript">
            @Html.Raw(ViewBag.JsScript)
        </script>
    </body>
}

