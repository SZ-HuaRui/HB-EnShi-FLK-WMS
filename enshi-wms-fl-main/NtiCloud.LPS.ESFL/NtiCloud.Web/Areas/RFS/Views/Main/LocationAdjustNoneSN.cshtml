@{ Layout = "~/Areas/RFS/Shared/Layout.cshtml";}
@section title{@("库位调整(无箱码)")}
@section footerScript{
    <script src="~/areas/rfs/js/LocationAdjustNoneSN.js"></script>
}
@section caption{@("库位调整(无箱码)")}
@section contentBody{
    <div class="warp">
        <div class="warp_d">
            <div class="border">
                <p class="rf_border"><span class="title">调整单号：</span><input type="text" id="txtAdjustNo" class="rf_border_d" /></p>
                <p class="rf_border">
                    <span class="title">物料名称：</span>
                    <span class="rf_border_d" id="txtItemName"></span>
                </p>
                <p class="rf_border"><span class="title">批次：</span><span class="rf_border_d" id="txtlot_no"></span></p>
                <p class="rf_border">
                    <span class="title">供应商：</span>
                    <span class="rf_border_d" id="txtSupplier"></span>
                </p>
                <p class="rf_border">
                    <span class="title">任务号：</span>
                    <span class="rf_border_d" id="txtTaskNo"></span>
                </p>
                <p class="rf_border">
                    <span class="title">移入库位：</span>
                    <span class="rf_border_d" id="txtInLocation"></span>
                </p>
                <p class="rf_border">
                    <span class="title">计划调整数量：</span>
                    <span class="rf_border_d" id="txtPlanQty"></span>
                </p>
                <p class="rf_border">
                    <span class="title">已调数量：</span>
                    <span class="rf_border_d" id="txtFinishedQty"></span>
                </p>
                <p class="rf_border">
                    <span class="title">调整数量：</span>
                    <input type="text" id="txtQty" class="rf_border_d" />
                </p>
                <p class="rf_border">
                    <span class="title">扫描移入库位：</span>
                    <input type="text" id="txtToInLocation" class="rf_border_d" />
                </p>
            </div>
            <div class="button_t button_top">
                <div class="button">
                    <button id="btnConfirm">确定</button>
                </div>
            </div>
        </div>
    </div>
}