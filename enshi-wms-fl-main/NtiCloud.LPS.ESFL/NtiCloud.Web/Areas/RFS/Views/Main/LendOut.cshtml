@{ Layout = "~/Areas/RFS/Shared/Layout.cshtml";}
@section title{@("借出")}
@section footerScript{
    <script src="~/areas/rfs/js/LendOut.js"></script>
}
@section caption{@("借出")}
@section contentBody{
    <div class="warp">
        <div class="warp_d">
            <div class="border">
                <p class="rf_border">
                    <span class="title">借出单号:</span>
                    <select id="orderNo"></select>
                </p>
                <p class="rf_border">
                    <span class="title">物料名称:</span>
                    <select id="item_name"></select>
                </p>
                <p class="rf_border">
                    <span class="title">托盘条码:</span>
                    <input id="container_code" type="text" placeholder="请扫描托盘条码" name="fname" />
                </p>
                <p class="rf_border">
                    <span class="title">货位编码:</span>
                    <span id="location_code"></span>
                </p>
            </div>
            <div class="between">
                <p class="rf_border"><span class="title">一号工程码 :</span><input id="one_code" type="text" placeholder="请扫描，勿手动输入" name="fname" /></p>
                <div class="between_d"></div>
            </div>
            <div class="name">
                @*<p class="rf_border">
                        <span class="title">物料编码:</span>
                        <span id="item_code"></span>
                    </p>*@
                <p class="rf_border">
                    <span class="title">实际数量:</span>
                    <span id="actual_num">24</span>
                </p>

                @*<p class="rf_border name_b">
                        <span class="title">剩余件数:</span>
                        <span id="left_num"></span>
                    </p>*@
            </div>
            <div class="button_t">
                <div class="button">
                    <a class="conform_btn">确定</a>
                    <a class="delete_btn">删除</a>
                </div>
            </div>
        </div>
    </div>
}