@{ Layout = "~/Areas/RFS/Shared/Layout.cshtml";}
@section title{@("货位调整")}
@section footerScript{
    <script src="~/areas/rfs/js/PositionAdjust.js"></script>
}
@section caption{@("平库无箱码拣选列表")}
@section contentBody{
    <div class="warp">
        <div class="warp_d">
            <div class="border">
                <p class="rf_border"><span class="title">托盘条码：</span><input class="container_code" type="text" placeholder="请扫描" name="fname" /></p>
                <p class="rf_border">
                    <span class="title">货位编码：</span>
                    <span class="rf_border_d" id="location_code"></span>
                </p>
                <p class="rf_border">
                    <span class="title">物料名称：</span>
                    <span class="rf_border_d" id="item_name"></span>
                </p>
                <p class="rf_border">
                    <span class="title">物料编码：</span>
                    <span class="rf_border_d" id="item_code"></span>
                </p>
                <p class="rf_border">
                    <span class="title">批次号：</span>
                    <span class="rf_border_d" id="batch_number"></span>
                </p>
                <p class="rf_border">
                    <span class="title">入库日期：</span>
                    <span class="rf_border_d" id="shelve_data"></span>
                </p>
            </div>
            <div class="button_t">
                <div class="button">
                    <a class="storage_area">入暂存区</a>
                    <a class="conform_btn">确定</a>
                </div>
            </div>
        </div>
    </div>
}