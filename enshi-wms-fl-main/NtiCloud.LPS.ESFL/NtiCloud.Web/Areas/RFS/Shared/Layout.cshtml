<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="pragram" content="no-cache" />
    <meta http-equiv="cache-control" content="no-cache, must-revalidate" />
    <title>@RenderSection("title", false)</title>
    <link href="~/areas/rfs/css/reset.css" rel="stylesheet" />
    <link href="~/lib/layui/css/layui.css" rel="stylesheet" />
    <link href="~/areas/rfs/css/common.css" rel="stylesheet" />
    <link href="~/areas/rfs/css/groupcontainer.css" rel="stylesheet" />
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/layui/layui.js"></script>
    <script src="~/lib/layui/layui.all.js"></script>
    <script src="~/js/common.js"></script>
    <script src="~/js/apiRoute.js"></script>
    <script src="~/areas/admin/js/jquery.layui.plus.js"></script>
    @RenderSection("footerScript", false)
    <script src="~/areas/rfs/js/common.js"></script>
    <script src="~/lib/CryptoJS/components/core-min.js"></script>
    <script src="~/lib/CryptoJS/rollups/aes.js"></script>
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="top_nav">
        <p><strong>@RenderSection("caption", false)</strong></p>
        <div class="rf_head">
            <a href="javascript:history.go(-1)" class="rf_goback">返回</a>
        </div>
        <div class="rf_headmain">
            <a href="/RFS/Main/Index" class="rf_home">主页</a>
            <a class="rf_out">退出</a>
        </div>
    </div>
    @RenderSection("contentBody")
</body>
</html>
