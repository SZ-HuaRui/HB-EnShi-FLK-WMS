@{
    Layout = "~/Views/Shared/Laylogin.cshtml";
}
@section TitleSection{今天云平台注册}
@section HeaderSection{
    <link href="~/css/cloud_register.css" rel="stylesheet" />
    <script src="~/js/cloud_register.js"></script>
}
@section ContentBody{
    <div class="main_content center-block">
        <div class="main_con">
            <div class="logo">
                <a href="/">
                    <img src="~/img/logo3.png" />
                </a>
            </div>
            <span class="mdi mdi-window-close delete" onclick="ohterRegister('.delete')"></span>
            <div id="register1" style="display:block">
                <p class="phone_num"><input type="text" id="usermob" placeholder="输入手机号码"><span class="phone_tip"></span></p>
                <div class="input_phone">
                    <p class="botton_p"><a href="#" onclick="registerMob()">下一步</a></p>
                    <div class="other_login">
                        <p>
                            <span class="other_login_t">其他注册方式：</span><a style='cursor:pointer;'><img class="ding" onclick="ohterRegister('.ding_login')" src="~/img/icon_dingding.png"></a><a style='cursor:pointer;'><img class="wechat" onclick="ohterRegister('.wechat_login')" src="~/img/icon_wechat.png"></a>
                        </p>
                        <p class="forget_password">我有账号<a href="/Main/Login" class="sign">登录</a></p>
                    </div>
                </div>
                <div class="second_s" style="display:none">
                    <p class="valida"><input type="text" id="VlidataCode" placeholder="验证码" class="vlidata_code"><a class="code_text">获取验证码</a><span class="code_tip"></span></p>
                    <p class="user"><input type="text" id="username" placeholder="设置登录用户名"><span class="user_tip"></span></p>
                    <p class="password"><input type="password" id="userpswd1" placeholder="设置登录密码" autocomplete="off"><span class="password1_tip"></span></p>
                    <p class="password2"><input type="password" id="userpswd2" placeholder="再次输入密码" autocomplete="off"><span class="password2_tip"></span></p>
                    <input type="hidden" id="hiddenVlidataCode">
                    <!--div class="drag">
                        <div class="drag_bg"></div>
                        <div class="drag_text" onselectstart="return false;">请按住滑块，拖动到最右边</div>
                        <div class="drag_btn"></div>
                        <span class="check_tip"></span>
                    </div-->
                    <p class="register_btn"><a onclick="register()">注 册</a></p>
                    <p class="register_read">
                        <i class="isRead"></i>已阅读并同意<a href="/Main/Service">今天云服务协议</a>和<a>法律声明和隐私政策</a><br />
                        <span class="read_tip"></span>
                    </p>
                </div>
            </div>
            <div id="register2" style="display:none">
                <div class="title">填写企业资料</div>
                <p class="user"><input type="text" id="adminusername" placeholder="填写联系人姓名"><span class="adminuser_tip"></span></p>
                <p class="project_code"><input type="text" id="projectcode" placeholder="填写企业代码"><span class="project_code_tip"></span></p>
                <p class="project_name"><input type="text" id="projectname" placeholder="填写企业名称"><span class="project_name_tip"></span></p>
                <p class="email"><input type="text" id="useremail" placeholder="输入邮箱"><span class="project_mail_tip"></span></p>
                <p class="control_btn"><a onclick="registerOk()">进入控制台</a></p>
            </div>
            <div class="qrcode_login wechat_login">
                <div class="title"><span>微信注册</span><div id="login_weixin"></div></div>
            </div>
            <div class="qrcode_login ding_login">
                <div class="title"><span>钉钉注册</span><div id="login_container"></div></div>
            </div>
        </div>
        <div class="back_main">
            <p class="back_main_p"><span><</span><a href="/">返回首页</a></p>
            <p class="back_main_p"><a href="/Main/Register">使用其他账号注册</a></p>
        </div>
    </div>
}